{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "llrdai",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "MS_GRAPH_TENANT_ID": "23f14690-978b-44f2-8172-0e1bddcb0a07",
    "MS_GRAPH_CLIENT_ID": "ad67dcf8-be35-4e06-8b9e-8115a333e0e1",
    "LLRD_CONTACT_PROVIDER": "microsoft-graph",
    "LLRD_AI_ENABLED": "true",
    "LLRD_AI_PROVIDER": "groq",
    "LLRD_AI_MODEL": "openai/gpt-oss-20b",
    "LLRD_AI_FREE_PLAN_CONFIRMED": "true",
    "LLRD_LOCAL_STUDIO": "false",
    "SITE_INDEXABLE": "true",
    "LLRD_AI_TRUSTED_IP_HEADER": "CF-Connecting-IP",
    "LLRD_AI_ACCEPTANCE_RUN": "",
    "OPS_ENABLED": "true",
    "OPS_TIMEZONE": "America/Chicago",
    "OPS_INITIAL_REPORT_ID": "operations-launch-v1"
  },
  "routes": [
    {
      "pattern": "llrd.ai",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SITE_QUOTA",
        "class_name": "SiteQuota"
      },
      {
        "name": "OPERATIONS",
        "class_name": "OperationsMonitor"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-site-quota",
      "new_sqlite_classes": [
        "SiteQuota"
      ]
    },
    {
      "tag": "v2-operations",
      "new_sqlite_classes": [
        "OperationsMonitor"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "*/30 * * * *"
    ]
  }
}

