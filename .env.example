SITE_INDEXABLE=false
LLRD_LOCAL_STUDIO=false
# Website AI only; never use this configuration in SONIE or other product backends.
LLRD_AI_ENABLED=false
LLRD_AI_PROVIDER=groq
LLRD_AI_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=
# Confirm the account is on the free plan with no paid billing before enabling.
LLRD_AI_FREE_PLAN_CONFIRMED=false
# Only set to a header overwritten by your trusted hosting proxy.
# Unset means all visitors share a conservative bucket.
LLRD_AI_TRUSTED_IP_HEADER=
# Recipient: contactus@llrd.ai. Sending provider remains unselected.
# Never add NEXT_PUBLIC credentials. Local studio token is generated by its launcher.
# Owner-confirmed mailbox host: Microsoft 365. Website sending connection not configured.
